{
  "schemaVersion": 1,
  "id": "reputation",
  "version": "${version}",

  "name": "Your Reputation",
  "description": "a Jade plugin that displays your reputation on a tooltip with each villager.",
  "authors": ["Matej Stastny"],
  "contact": {
    "homepage": "https://github.com/matejstastny/your-reputation",
    "sources": "https://github.com/matejstastny/your-reputation",
    "issues": "https://github.com/matejstastny/your-reputation/issues"
  },

  "license": "MIT",
  "icon": "assets/reputation/icon.png",

  "environment": "*",
  "entrypoints": {
    "jade": ["matejstastny.reputation.ReputationPlugin"]
  },
  "mixins": ["reputation.mixins.json"],

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "jade": "*"
  }
}
